<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="650.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.CargoController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Gestion de cargos">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <VBox spacing="8.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="90.0" text="ID:" />
                  <TextField fx:id="txtId" prefHeight="26.0" prefWidth="150.0" promptText="ID " />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="90.0" text="Nombre:" />
                  <TextField fx:id="txtNombre" promptText="Ingrese el nombre del cargo" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="90.0" text="Descripcion:" />
                  <TextField fx:id="txtDescripcion" promptText="Ingresa la descripcion del cargo" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#guardar" prefWidth="90.0" text="Agregar" />
            <Button mnemonicParsing="false" onAction="#limpiar" prefWidth="90.0" text="Limpiar" />
            <Button mnemonicParsing="false" onAction="#cerrar" prefWidth="90.0" text="Cerrar" />
         </children>
      </HBox>

      <TableView fx:id="tblCargos" prefHeight="220.0" prefWidth="610.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="colDescripcion" prefWidth="320.0" text="Descripcion" />
         </columns>
      </TableView>
   </children>
</VBox>
