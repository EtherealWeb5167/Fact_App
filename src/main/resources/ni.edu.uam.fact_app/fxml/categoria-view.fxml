<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="480.0" prefWidth="600.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.fact_app.controller.CategoriaController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Gestion de categorias">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <VBox spacing="8.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="90.0" text="ID:" />
                  <TextField fx:id="txtId" prefHeight="26.0" prefWidth="150.0" promptText="ID" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="90.0" text="Nombre:" />
                  <TextField fx:id="txtNombre" promptText="Ingresa el nombre de la categoria" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label prefWidth="90.0" text="Estado:" />
                  <CheckBox fx:id="chkActiva" mnemonicParsing="false" selected="true" text="Categoria activa" />
               </children>
            </HBox>
         </children>
      </VBox>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#guardar" prefWidth="90.0" text="Agregar" />
            <Button mnemonicParsing="false" onAction="#limpiar" prefWidth="90.0" text="Limpiar" />
            <Button mnemonicParsing="false" onAction="#cerrar" prefWidth="90.0" text="Cerrar" />
         </children>
      </HBox>

      <TableView fx:id="tblCategorias" prefHeight="200.0" prefWidth="560.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="350.0" text="Nombre" />
            <TableColumn fx:id="colActiva" prefWidth="120.0" text="Activa" />
         </columns>
      </TableView>
   </children>
</VBox>
